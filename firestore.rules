rules_version = '2';
// Firebase 프로젝트(flashcard-1476f) 전체 규칙. flashcard 와 飲みログ가 같은 프로젝트를 쓰므로
// Firebase 콘솔 → Firestore → 규칙에는 이 파일 내용을 통째로 붙여 넣는다.
//
// 飲みログ 데이터 모델
//   members/{uid}              회원. status: pending(승인 대기) | active | rejected
//   handles/{handle}           아이디 → uid (아이디 중복 방지, 추천인 검색용 · 목록 조회 불가)
//   private/{uid}/logs/{id}    내 기록 원본 (나만 읽고 씀)
//   photos/{id}                사진 본문 (JPEG data URL). shared=true 인 것만 멤버가 읽음
//   posts/{id}                 멤버에게 공유한 기록 (같은 id). 공유할 항목만 복사됨
//   posts/{id}/comments/{cid}  댓글
//   posts/{id}/likes/{uid}     좋아요
//   follows/{follower_followee} 팔로우
//
// 가입 승인: 신청자가 members 에 status=pending + referrerUid 로 만들고,
//            추천인(active 멤버)만 status 를 active/rejected 로 바꿀 수 있다.
//            관리자(OWNER)만 추천인 없이 바로 active 로 만들 수 있다 (첫 멤버).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwnerPath(uid) {
      return uid == 'BZ9tnw3zjtc7Jh75G1SBOBR8ckM2';
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSelf('BZ9tnw3zjtc7Jh75G1SBOBR8ckM2');
    }
    function memberDoc(uid) {
      return get(/databases/$(database)/documents/members/$(uid));
    }
    function isActive() {
      return signedIn() && memberDoc(request.auth.uid).data.status == 'active';
    }
    // 좋아요·댓글 수는 한 번에 1씩만 바뀔 수 있다.
    function stepOk(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || (request.resource.data[field] >= 0
            && (request.resource.data[field] - resource.data[field] == 1
                || request.resource.data[field] - resource.data[field] == -1));
    }

    // ───────── flashcard ─────────
    match /shares/{id} {
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['d', 'owner', 'created'])
        && request.resource.data.d is string
        && request.resource.data.d.size() < 300000
        && request.resource.data.owner == request.auth.uid;
    }
    match /users/{uid}/{document=**} {
      allow read: if isOwnerPath(uid) || isSelf(uid);
      allow write: if isSelf(uid);
    }

    // ───────── 飲みログ: 회원 ─────────
    match /members/{uid} {
      // 로그인한 사람은 uid 를 알면 한 명씩 읽을 수 있고(추천인 확인용), 목록 조회는 active 멤버만.
      allow get: if signedIn();
      allow list: if isActive();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['handle', 'displayName', 'bio', 'status', 'referrerUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['handle', 'displayName', 'status', 'createdAt'])
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid
        && (
          (isAdmin() && request.resource.data.status == 'active')
          || (request.resource.data.status == 'pending'
              && request.resource.data.referrerUid is string
              && request.resource.data.referrerUid != uid
              && memberDoc(request.resource.data.referrerUid).data.status == 'active')
        );

      allow update: if isAdmin()
        // 본인: 닉네임·소개만
        || (isSelf(uid) && isActive()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio'])
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 20)
        // 추천인: 자기에게 온 대기 중 신청만 승인/거절
        || (isActive()
            && resource.data.get('referrerUid', '') == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['active', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'approvedBy'])
            && (!request.resource.data.keys().hasAny(['approvedBy']) || request.resource.data.approvedBy == request.auth.uid));

      // 신청 취소 / 거절 후 재신청
      allow delete: if isAdmin() || (isSelf(uid) && resource.data.status in ['pending', 'rejected']);
    }

    match /handles/{handle} {
      allow get: if signedIn();
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.handle == handle;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && memberDoc(request.auth.uid).data.status in ['pending', 'rejected']);
    }

    // ───────── 飲みログ: 내 기록 (비공개 원본) ─────────
    match /private/{uid}/logs/{id} {
      allow read, write: if isSelf(uid) && isActive();
    }

    // ───────── 飲みログ: 사진 (무료 요금제라 Storage 대신 Firestore 에 저장) ─────────
    match /photos/{id} {
      allow get: if isActive() && (resource.data.ownerUid == request.auth.uid || resource.data.shared == true);
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['ownerUid', 'logId', 'shared', 'data', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.shared is bool
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shared']);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // ───────── 飲みログ: 공유된 게시물 ─────────
    match /posts/{id} {
      allow read: if isActive();
      // 게스트(로그아웃 상태): 최근 글 5개까지만 목록으로 볼 수 있다 (사진 원본·댓글·멤버 정보는 불가)
      allow list: if request.auth == null && request.query.limit <= 5;
      allow create: if isActive()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow update: if isActive() && (
        // 작성자 수정 (수는 그대로)
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.likeCount == resource.data.likeCount
          && request.resource.data.commentCount == resource.data.commentCount)
        // 누구나: 좋아요·댓글 수만 ±1
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
            && stepOk('likeCount') && stepOk('commentCount'))
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);

      match /comments/{cid} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.keys().hasOnly(['authorUid', 'text', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && exists(/databases/$(database)/documents/posts/$(id));
        allow delete: if isAdmin()
          || (signedIn() && (resource.data.authorUid == request.auth.uid
              || get(/databases/$(database)/documents/posts/$(id)).data.ownerUid == request.auth.uid));
      }

      match /likes/{uid} {
        allow read: if isActive();
        allow create: if isActive() && isSelf(uid)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && exists(/databases/$(database)/documents/posts/$(id));
        allow delete: if signedIn()
          && (isSelf(uid) || get(/databases/$(database)/documents/posts/$(id)).data.ownerUid == request.auth.uid);
      }
    }

    // ───────── 飲みログ: 알림 (좋아요·댓글이 달리면 글쓴이에게) ─────────
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['toUid', 'fromUid', 'type', 'postId', 'postName', 'text', 'read', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.type in ['like', 'comment', 'mention']
        && request.resource.data.read == false;
      allow update: if isActive() && (
        (resource.data.toUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || (resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.type == resource.data.type
          && request.resource.data.read == false));
      allow delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    // ───────── 쪽지(DM) ─────────
    match /chats/{chatId} {
      allow read: if isActive() && request.auth.uid in resource.data.members;
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['members', 'lastText', 'lastAt', 'lastFrom', 'reads'])
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.lastFrom == request.auth.uid
        && memberDoc(request.resource.data.members[0] == request.auth.uid
             ? request.resource.data.members[1] : request.resource.data.members[0]).data.status == 'active';
      allow update: if isActive() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastAt', 'lastFrom', 'reads']);

      match /messages/{mid} {
        allow read: if isActive() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isActive()
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000;
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }

    // ───────── 飲みログ: 팔로우 ─────────
    match /follows/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['followerUid', 'followeeUid', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followeeUid != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.followeeUid
        && memberDoc(request.resource.data.followeeUid).data.status == 'active';
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
    }
  }
}
